<Project>
  <!-- Version -->
  <PropertyGroup>
    <Version>22.0.0</Version>
    <AssemblyVersion>22.0.0</AssemblyVersion>
    <FileVersion>22.0.0</FileVersion>
  </PropertyGroup>
  <!-- Build -->
  <PropertyGroup>
    <LangVersion>12</LangVersion>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <SignAssembly>True</SignAssembly>
    <AssemblyOriginatorKeyFile>Workflow.snk</AssemblyOriginatorKeyFile>
    <NoWarn>NU1903</NoWarn>
  </PropertyGroup>
  <!-- Nuget -->
  <PropertyGroup>
    <Company>Optimajet Limited</Company>
    <Product>Workflow Engine</Product>
    <Authors>Optimajet Limited</Authors>
    <Copyright>OptimaJet Workflow Engine 2026</Copyright>
    <PackageProjectUrl>https://workflowengine.io</PackageProjectUrl>
    <PackageReleaseNotes>https://workflowengine.io/documentation/release-notes/workflow-engine/</PackageReleaseNotes>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <PackageIconUrl>https://workflowengine.io/images/favicons/favicon.ico</PackageIconUrl>
    <RepositoryUrl>https://github.com/optimajet/WorkflowEngine.NET</RepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-2m69-gcr7-jv3q" />
  </ItemGroup>
</Project>